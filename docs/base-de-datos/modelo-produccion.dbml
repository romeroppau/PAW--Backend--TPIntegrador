// ---------- Claves foráneas ----------

Ref fk_adopcion_adoptante: adopcion.adoptante_id > usuario.id
Ref fk_adopcion_publicacion: adopcion.publicacion_id > publicacion.id
Ref fk_adopcion_turno_chequeo: adopcion.turno_chequeo_id > turno.id
Ref fk_carrito_cliente: carrito.cliente_id > usuario.id
Ref fk_configuracion_usuario: configuracion.actualizado_por > usuario.id
Ref fk_consulta_turno: consulta.turno_id > turno.id
Ref fk_evento_consulta: evento_sanitario.consulta_id > consulta.id
Ref fk_evento_mascota: evento_sanitario.mascota_id > mascota.id
Ref fk_evento_plan: evento_sanitario.plan_sanitario_id > plan_sanitario.id
Ref fk_factura_compra_carrito: factura_compra.carrito_id > carrito.id
Ref fk_factura_compra_entrega: factura_compra.entregada_por > usuario.id
Ref fk_factura_consulta: factura_consulta.consulta_id > consulta.id
Ref fk_item_carrito_carrito: item_carrito.carrito_id > carrito.id
Ref fk_item_carrito_producto: item_carrito.producto_id > producto.id
Ref fk_item_insumo_consulta: item_insumo_consulta.consulta_id > consulta.id
Ref fk_item_insumo_insumo: item_insumo_consulta.insumo_id > insumo.id
Ref fk_item_producto_consulta: item_producto_consulta.consulta_id > consulta.id
Ref fk_item_producto_producto: item_producto_consulta.producto_id > producto.id
Ref fk_lote_insumo: lote_insumo.insumo_id > insumo.id
Ref fk_lote_producto: lote_producto.producto_id > producto.id
Ref fk_mascota_duenio: mascota.duenio_id > usuario.id
Ref fk_movimiento_insumo: movimiento_inventario.insumo_id > insumo.id
Ref fk_movimiento_lote: movimiento_inventario.lote_id > lote_producto.id
Ref fk_movimiento_lote_insumo: movimiento_inventario.lote_insumo_id > lote_insumo.id
Ref fk_movimiento_producto: movimiento_inventario.producto_id > producto.id
Ref fk_movimiento_usuario: movimiento_inventario.usuario_id > usuario.id
Ref fk_notificacion_usuario: notificacion.usuario_id > usuario.id
Ref fk_pago_factura: pago.factura_compra_id > factura_compra.id
Ref fk_postulacion_adopcion: postulacion.adopcion_id > adopcion.id
Ref fk_postulacion_cliente: postulacion.cliente_id > usuario.id
Ref fk_promocion_lote: promocion.lote_id > lote_producto.id
Ref fk_promocion_producto: promocion.producto_id > producto.id
Ref fk_promocion_usuario: promocion.creada_por > usuario.id
Ref fk_promocion_franja_usuario: promocion_franja.creada_por > usuario.id
Ref fk_publicacion_mascota: publicacion.mascota_id > mascota.id
Ref fk_publicacion_rescatista: publicacion.rescatista_id > usuario.id
Ref fk_publicacion_rechazo_publicacion: publicacion_rechazo.publicacion_id > publicacion.id
Ref fk_publicacion_rechazo_veterinaria: publicacion_rechazo.rechazada_por > usuario.id
Ref fk_resena_autor: resena.autor_id > usuario.id
Ref fk_resena_respondida_por: resena.respondida_por > usuario.id
Ref fk_turno_mascota: turno.mascota_id > mascota.id
Ref fk_turno_promocion_franja: turno.promocion_franja_id > promocion_franja.id
Ref fk_turno_veterinario: turno.veterinario_id > usuario.id
Ref fk_turno_motivo_evento: turno_motivo.evento_sanitario_id > evento_sanitario.id
Ref fk_turno_motivo_turno: turno_motivo.turno_id > turno.id
Ref fk_usuario_validado_por: usuario.validado_por > usuario.id
Ref fk_verificacion_usuario: verificacion_whatsapp.usuario_id > usuario.id

// ---------- Tablas por módulo ----------

TableGroup Backend {
  configuracion
  notificacion
  resena
  usuario
  verificacion_whatsapp
}

TableGroup Inventario {
  carrito
  factura_compra
  insumo
  item_carrito
  lote_insumo
  lote_producto
  movimiento_inventario
  pago
  producto
  promocion
}

TableGroup Pacientes {
  consulta
  evento_sanitario
  factura_consulta
  item_insumo_consulta
  item_producto_consulta
  mascota
  plan_sanitario
  promocion_franja
  turno
  turno_motivo
}

TableGroup Adopciones {
  adopcion
  postulacion
  publicacion
  publicacion_rechazo
}

TableGroup Migraciones {
  migracion
}

// Vista v_turnos_atendidos (no es tabla; la lee Reportes):
// select t.id AS turno_id,t.fecha AS fecha,t.hora AS hora,t.motivo AS motivo,t.mascota_id AS mascota_id,t.veterinario_id AS veterinario_id,c.id AS consulta_id,c.diagnostico AS diagnostico,c.finalizada_en AS finalizada_en,(select count(0) from item_insumo_consulta i where (i.consulta_id = c.id)) AS cantidad_insumos,(select count(0) from item_producto_consulta p where (p.consulta_id = c.id)) AS cantidad_productos,f.numero AS factura_numero,f.subtotal_base AS subtotal_base,f.subtotal_insumos AS subtotal_insumos,f.subtotal_productos AS subtotal_productos,f.total AS total,f.estado AS factura_estado from ((turno t join consulta c on(((c.turno_id = t.id) and (c.estado = 'FINALIZADA')))) join factura_consulta f on((f.consulta_id = c.id))) where (t.estado = 'ATENDIDO')
